# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# Your own Gemini API key from Google AI Studio (https://aistudio.google.com).
# Leave empty to run in mock mode (no key, no network, canned responses).
GEMINI_API_KEY=

# Model to call. Change this if Google renames or retires the model.
GEMINI_MODEL=gemini-3.6-flash

# Set to true to force mock mode even when a key is present.
MOCK_MODE=false

# Simulated response time in mock mode, in milliseconds.
MOCK_DELAY_MS=800
